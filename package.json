{
  "name": "@maaamahahh/pi-math-sixel",
  "version": "1.0.0",
  "description": "Render LaTeX math formulas as Sixel images in Pi TUI for Windows Terminal and Sixel-capable terminals",
  "type": "module",
  "main": "./src/index.ts",
  "exports": {
    ".": "./src/index.ts"
  },
  "files": [
    "src",
    "README.md",
    "LICENSE"
  ],
  "pi": {
    "extensions": [
      "./src/index.ts"
    ]
  },
  "scripts": {
    "typecheck": "tsc --noEmit",
    "test": "node --import tsx --test test/*.test.ts",
    "check": "npm run typecheck && npm test"
  },
  "dependencies": {
    "@mathjax/src": "^4.1.3",
    "@resvg/resvg-js": "^2.6.2"
  },
  "peerDependencies": {
    "@earendil-works/pi-coding-agent": "*",
    "@earendil-works/pi-tui": "*"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "tsx": "^4.19.0",
    "typescript": "^5.7.0"
  },
  "keywords": [
    "pi",
    "pi-package",
    "pi-extension",
    "pi-coding-agent",
    "latex",
    "math",
    "sixel",
    "windows-terminal"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/maaamahAhh/pi-math-sixel.git"
  },
  "homepage": "https://github.com/maaamahAhh/pi-math-sixel#readme",
  "bugs": {
    "url": "https://github.com/maaamahAhh/pi-math-sixel/issues"
  },
  "license": "Unlicense"
}
